        "id": "order-alice-001",
        "userId": "user-alice",
        "items": [
          {
            "productId": "prod-001",
            "quantity": 1,
            "priceAtPurchase": 7999
          }
        ],
        "total": 7999,
        "createdAt": "2026-11-01T10:00:00Z"
      }
    },
