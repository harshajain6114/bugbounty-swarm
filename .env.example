# NEAR Testnet Configuration for BUGBOUNTY SWARM
# TESTNET ONLY — never use mainnet or real funds.
#
# HOW TO GET THESE VALUES:
#  1. Create a testnet account at https://testnet.mynearwallet.com
#  2. Run: near login  (requires NEAR CLI: npm install -g near-cli)
#  3. Find your key at: ~/.near-credentials/testnet/<account>.json
#  4. Deploy contract: see apps/near-contract/README.md
#
# SECURITY WARNING:
#  - NEVER commit this file with real values filled in.
#  - NEVER share or log your NEAR_PRIVATE_KEY.
#  - Add .env to your .gitignore.

NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ACCOUNT_ID=your-operator.testnet
NEAR_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY_HERE
NEAR_CONTRACT_ID=bugbounty-swarm.your-operator.testnet
