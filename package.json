{
  "name": "bugbounty-swarm-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/start-all.js",
    "verify:near": "node scripts/verify-near.js",
    "verify:market": "node scripts/verify-market.js",
    "test:contract": "cargo test --manifest-path apps/near-contract/Cargo.toml",
    "test:market-contract": "cargo test --manifest-path apps/near-market-contract/Cargo.toml",
    "test:server": "cd apps/server && node node_modules/tsx/dist/cli.mjs tests/run-all.ts",
    "test:orchestrator": "cd apps/server && node node_modules/tsx/dist/cli.mjs tests/mission-orchestrator.test.ts",
    "build:web": "cd apps/web && npm run build"
  }
}
