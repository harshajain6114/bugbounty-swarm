            "containsDangerousInnerHtmlSink": true,
            "containsPayloadInScript": true,
            "sinkSnippet": "document.getElementById('review-content-review-1').innerHTML = \"<img src=\\\"x\\\" onerror=\\\"window.__bugbounty_xss_test='EXECUTED'\\\">\";"
